# SUPABASE
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
# The bucket's S3 endpoint only: no bucket name or path on the end, or objects
# land under an extra prefix and their public URLs won't resolve.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public domain (a custom domain or its r2.dev URL). Avatars are
# stored in R2_BUCKET under avatars/{userId}.webp and served from here, so
# without it avatar uploads answer 503. This makes the whole bucket publicly
# readable by key: script file keys are random UUIDs and only ever given out
# with a script, but a key that leaks no longer expires.
R2_PUBLIC_URL=

# CORS
# The three localhost ports are allowed automatically outside production; this
# list covers everything else and is the only source in production (entries
# like `*.scriptr.uk` match any https subdomain). The hosted Sanity Studio must
# be listed there or its browser sync/delete actions fail the preflight.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3333,https://scriptr.sanity.studio

# Development
NODE_ENV=development
PORT=8787

# Sitemap: scopes GET /api/sitemap/scripts. The Next build holds the only copy,
# so the two values must match — `openssl rand -base64 32`.
SITEMAP_SECRET=development_sitemap_secret

# Sanity Studio access: base32 TOTP secret. Generate one with
# `corepack pnpm --filter @scriptr/api admin:totp`, add it to an authenticator
# app from the printed otpauth URI, and paste the secret here. Studio actions
# ask for the current code once per ten minutes.
ADMIN_TOTP_SECRET=

# The only origin allowed to call /api/sanity/*. Required in production: an
# /api/sanity request with a missing or different Origin is rejected with 403,
# even if it carries a valid code. List it in CORS_ORIGINS too.
SANITY_STUDIO_ORIGIN=https://scriptr.sanity.studio

# The only origin allowed to call /api/admin/* (the site's admin surface).
# Production uses the public hostname; staging and local dev need their own
# value. Also list it in CORS_ORIGINS.
WEBSITE_ORIGIN=http://localhost:3000


# Next.js cache revalidation (must match REVALIDATE_SECRET in next/.env)
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=development_secret_key

# File optimizer service (optional; set both or neither). Without them,
# /file-ops/finalize uses an in-process stand-in that validates files but does
# not shrink them. With only one set, or an unreachable service, finalize
# fails with 503 rather than storing a file unoptimized.
# OPTIMIZER_URL=http://localhost:8788
# OPTIMIZER_SECRET=optimizer_secret_key