{
  "extends": "../shared/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext"],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*.ts"]
}
