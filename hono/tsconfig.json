{
  "extends": "../shared/tsconfig.base.json",
  "files": ["src/sanity-stub.d.ts", "../shared/types/sanity-client-stub.d.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext"],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"]
    },
    "typeRoots": ["../node_modules/@types"],
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*.ts"]
}
