{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext"],
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "extends": "../tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"]
}
