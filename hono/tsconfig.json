{
  "extends": "../shared/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext"],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"],
      "@sanity/client": ["./src/sanity-stub.d.ts"]
    },
    "typeRoots": ["../node_modules/@types", "../shared/types"],
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "**/*.tsx"]
}
