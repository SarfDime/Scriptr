{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "supabase": "^2.117.0",
    "tsx": "^4.23.13"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/supabase.ts"
  },
  "name": "@scriptr/api",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node --env-file=.env --import=tsx src/server.ts",
    "gen:types": "supabase gen types typescript --project-id \"$PROJECT_REF\" --schema public > ../shared/types/database.types.ts"
  },
  "type": "module"
}
