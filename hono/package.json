{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@scriptr/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/supabase.ts"
  },
  "name": "@scriptr/api",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env --import=tsx src/server.ts",
    "gen:types": "supabase gen types typescript --project-id \"$PROJECT_REF\" --schema public > ../shared/types/database.types.ts"
  },
  "type": "module"
}
