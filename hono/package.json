{
  "name": "@scriptr/api",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx src/server.ts",
    "gen:types": "supabase gen types typescript --project-id scriptr --schema public > src/types/supabase.ts",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/supabase.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "supabase": "^2.116.0",
    "tsx": "^4.23.12"
  }
}
