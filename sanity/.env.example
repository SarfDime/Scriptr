# Public identifiers: Vite inlines every SANITY_STUDIO_* value into the bundle.
SANITY_STUDIO_PROJECT_ID=your-sanity-project-id
SANITY_STUDIO_DATASET=production
# Only `sanity deploy` needs it.
SANITY_STUDIO_APP_ID=your-studio-app-id

SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
# Production Studio builds must use https://api.scriptr.uk.
SANITY_STUDIO_API_URL=http://localhost:8787

# No API secret belongs here: Studio builds inline every `SANITY_STUDIO_*` value
# into the browser bundle. Sync actions ask for a TOTP code instead and exchange
# it for a ten-minute token. This origin must equal the API's
# `SANITY_STUDIO_ORIGIN` and appear in its `CORS_ORIGINS`.

# `sanity deploy` and `sanity build` load `sanity/.env.production` on top of
# this file (Vite production mode), so put the production API URL there instead
# of editing this one. Keep `.env` pointed at localhost so `sanity dev` never
# syncs against production.
