SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
# Production Studio builds must use https://api.scriptr.uk.
SANITY_STUDIO_API_URL=http://localhost:8787
SANITY_STUDIO_INTERNAL_SECRET=development_secret_key

# `sanity deploy` and `sanity build` load `sanity/.env.production` on top of
# this file (Vite production mode), so put the production API URL and the
# real secret there instead of editing this one. Keep `.env` pointed at
# localhost so `sanity dev` never syncs against production.
