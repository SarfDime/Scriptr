{
  "dependencies": {
    "@portabletext/editor": "^8.2.4",
    "@portabletext/types": "^4.0.2",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^8.9.0",
    "@sanity/dashboard": "^6.0.22",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.9",
    "@sanity/uuid": "^3.0.3",
    "@sanity/vision": "^6.19.0",
    "@scriptr/shared": "workspace:*",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "sanity": "^6.19.0",
    "sanity-plugin-iframe-pane": "^5.0.41",
    "sanity-plugin-media": "^6.3.5",
    "sanity-plugin-mermaid-content-model": "^2.0.0",
    "sanity-plugin-references": "^1.2.0",
    "sanity-plugin-smart-asset-manager": "^2.0.1",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@sanity/cli": "^8.18.0",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0"
  },
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "name": "scriptr-sanity",
  "private": true,
  "scripts": {
    "build": "sanity build",
    "check-types": "tsc --noEmit --pretty",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "deploy-graphql:default": "sanity graphql deploy --dataset production",
    "deploy-graphql:dry": "sanity graphql deploy --dataset production --dry-run",
    "deploy-graphql:force": "sanity graphql deploy --dataset production --force",
    "dev": "sanity dev",
    "dev:ninja": "console-ninja sanity dev",
    "preview": "corepack pnpm build && sanity preview",
    "schema:extract": "sanity schemas extract --force --enforce-required-fields",
    "typegen": "corepack pnpm schema:extract && corepack pnpm types:generate",
    "types:generate": "sanity typegen generate"
  },
  "type": "module",
  "version": "1.0.0"
}
