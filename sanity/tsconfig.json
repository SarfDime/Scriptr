{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["../shared/**/*.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [".sanity", "node_modules", "dist"]
}
