# Used by `docker build -f optimizer/Dockerfile .` from the repository root.
# Keep the context small and keep secrets out of the image.

.git
**/node_modules
**/dist
**/.next
**/.sanity
**/.vercel
.codegraph
**/*.tsbuildinfo

**/.env
**/.env.*
!**/.env.example
cookies-*.txt

# The install needs every workspace's manifest (the lockfile covers them all),
# but the optimizer build uses only `shared/` and `optimizer/`.
hono/*
!hono/package.json
next/*
!next/package.json
sanity/*
!sanity/package.json
