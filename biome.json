{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.vscode/**/*",
      "!next/sanity.types.ts",
      "!**/node_modules/**/*",
      "!**/public/**/*",
      "!**/.next/**/*",
      "!**/.sanity/**/*",
      "!**/.cache/**/*",
      "!**/.turbo/**/*",
      "!**/.vercel/**/*",
      "!**/.netlify/**/*",
      "!**/out/**/*",
      "!**/dist/**/*",
      "!**/coverage/**/*",
      "!**/coverage-ts/**/*"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExtraBooleanCast": "error",
        "noForEach": "off",
        "noVoid": "error"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noReactPropAssignments": "error",
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": false
          }
        },
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "a11y": {
        "noNoninteractiveElementInteractions": "error",
        "noStaticElementInteractions": "error",
        "useAltText": "error",
        "useFocusableInteractive": "error",
        "useKeyWithClickEvents": "error",
        "useSemanticElements": "warn"
      },
      "nursery": {
        "noDuplicateFieldDefinitionNames": "error",
        "noDuplicateSelectors": "off",
        "noEmptyObjectKeys": "error",
        "useReactCompiler": {
          "level": "on",
          "options": {
            "compilationMode": "infer"
          }
        },
        "useReactNamingConvention": "error"
      },
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "warn",
        "noParameterProperties": "error",
        "useBlockStatements": "off",
        "useConsistentObjectDefinitions": "warn",
        "useImportType": "error",
        "useNodejsImportProtocol": "off",
        "useSelfClosingElements": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConsole": "warn",
        "noEmptyBlockStatements": "error",
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/*.d.ts",
        "!hono/src/types/supabase.ts",
        "!shared/types/database.types.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentArrayType": {
              "level": "error",
              "options": {
                "syntax": "generic"
              }
            },
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"],
                    "selector": {
                      "kind": "const",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["camelCase"],
                    "selector": {
                      "kind": "let",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["camelCase"],
                    "selector": {
                      "kind": "var",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["camelCase", "PascalCase"],
                    "selector": {
                      "kind": "function",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["camelCase"],
                    "selector": {
                      "kind": "functionParameter",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["PascalCase"],
                    "selector": {
                      "kind": "typeLike",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["PascalCase"],
                    "selector": {
                      "kind": "enum",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["PascalCase", "CONSTANT_CASE"],
                    "selector": {
                      "kind": "enumMember",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": ["camelCase", "snake_case"],
                    "match": "_?(.+)",
                    "selector": {
                      "kind": "typeProperty",
                      "scope": "any"
                    }
                  },
                  {
                    "formats": [
                      "camelCase",
                      "snake_case",
                      "CONSTANT_CASE",
                      "PascalCase"
                    ],
                    "match": "_?(.+)",
                    "selector": {
                      "kind": "objectLiteralMember",
                      "scope": "any"
                    }
                  }
                ],
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.tsx", "**/*.jsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useUniqueElementIds": "off"
          }
        }
      }
    },
    {
      "includes": [
        "next/app/**/*",
        "next/next.config.ts",
        "next/postcss.config.mjs",
        "hono/**/*",
        "sanity/**/*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      },
      "includes": ["next/styles/**/*.css"]
    }
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
