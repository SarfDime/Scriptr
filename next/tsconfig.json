{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"]
      // TODO: See if need to keep, imports may work without these paths, but may be useful for IDEs
      // "@/layouts/*": ["./layouts/*"],
      // "@/components/*": ["./components/*"],
      // "@/styles/*": ["./styles/*"],
      // "@/types/*": ["./types/*"],
      // "@/hooks/*": ["./hooks/*"],
      // "@/lib/*": ["./lib/*"]
    }
  },
  "include": [
    "../shared/**/*.ts",
    "types/env.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
