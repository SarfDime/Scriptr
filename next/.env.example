# Local development: the browser and the server both call the API directly.
# Deployed: https://api.scriptr.uk (inlined at build; the API sets
# COOKIE_DOMAIN=.scriptr.uk so the session cookie is shared with scriptr.uk).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_ENVIRONMENT_TYPE=development
# The catalog's origin. A study is served at `<siteSlug>.<this host>`, so this
# value also decides every study's address and canonical: `https://scriptr.uk`
# makes `lbe` live at `https://lbe.scriptr.uk`, and this local value makes it
# `http://lbe.localhost:3000`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# A localhost origin serves studies at `/study/<handle>`, so the dev session
# cookie and every tool that does not resolve `*.localhost` keep working. Set
# this to `true` to serve them from `<handle>.localhost:3000` instead.
# NEXT_PUBLIC_STUDY_HOSTS=true
NEXT_PUBLIC_SANITY_WEBSITE_ID=your-sanity-website-id
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_AUTH_TOKEN=your-sanity-token

# Shared secret the Hono API sends to POST /api/revalidate to invalidate script cache tags
REVALIDATE_SECRET=development_secret_key

# Scopes the sitemap's script list (`x-sitemap-secret`). Server-only; must match
# SITEMAP_SECRET in hono/.env. It grants nothing beyond that one read route.
SITEMAP_SECRET=development_sitemap_secret

# Shared secret Sanity sends in `x-sanity-webhook-secret` to
# POST /api/sanity/revalidate. Without it, an editorial publish only reaches
# readers on the next deploy. Server-only.
SANITY_REVALIDATE_SECRET=development_sanity_webhook_secret

# Build-time flag for the Vercel project; harmless locally. Keeps Next.js from
# sending build telemetry.
NEXT_TELEMETRY_DISABLED=1
