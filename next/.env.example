# Local development: the browser and the server both call the API directly.
# Deployed: https://api.scriptr.uk (inlined at build; the API sets
# COOKIE_DOMAIN=.scriptr.uk so the session cookie is shared with scriptr.uk).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_ENVIRONMENT_TYPE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_WEBSITE_ID=your-sanity-website-id
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_AUTH_TOKEN=your-sanity-token

# Shared secret the Hono API sends to POST /api/revalidate to invalidate script cache tags
REVALIDATE_SECRET=development_secret_key
