{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd .. && corepack pnpm --filter scriptr-next build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "main-sanity": false,
      "staging": false
    }
  },
  "installCommand": "cd .. && corepack pnpm install --frozen-lockfile --filter scriptr... --filter scriptr-next..."
}
